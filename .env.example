# ---------------------------------------------------------------------------
# Osora Studio — environment
#
# Copy to .env.local. Everything here has a working default or is optional:
# the first milestone runs on seeded data with mock providers, so `npm run dev`
# works with no configuration at all.
#
# Never commit real values. Only NEXT_PUBLIC_* variables reach the browser.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Optional in the first milestone. Without these the studio reads seeded data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security — never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Private storage bucket for audio. Assets are served through signed URLs.
SUPABASE_AUDIO_BUCKET=audio

# --- Language model providers ----------------------------------------------
# Which provider the composer uses: mock | anthropic | openai | gemini
LLM_PROVIDER=mock

# Server-only. Absent keys simply make that provider unselectable in the UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Voice and sound providers ---------------------------------------------
# mock | elevenlabs
TTS_PROVIDER=mock

# Server-only.
ELEVENLABS_API_KEY=

# --- Audio toolchain -------------------------------------------------------
# Only set these if ffmpeg/ffprobe are not on PATH. Without them no asset can
# be marked ready, because measurement is mandatory rather than best-effort.
FFMPEG_PATH=
FFPROBE_PATH=

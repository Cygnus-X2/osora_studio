# ---------------------------------------------------------------------------
# Osora Studio — server environment (Hetzner / Docker)
#
# Copy to .env.production on the server. Never commit the filled-in version.
# Leave a variable out entirely rather than setting it blank.
# ---------------------------------------------------------------------------

# Hostname pointed at this server. Caddy uses it to obtain TLS automatically.
# Leave unset to serve plain HTTP on :80 (IP-only trial).
OSORA_DOMAIN=studio.osora.example

# Audio lives on the mounted volume. Do not change unless you also change the
# volume mount in docker-compose.yml.
AUDIO_STORAGE_DIR=/data/audio

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIO_BUCKET=audio

# --- Providers -------------------------------------------------------------
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
